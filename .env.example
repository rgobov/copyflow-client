# copyflow-client
CF_WEBHOOK_SECRET=
CF_LISTEN_HOST=127.0.0.1
CF_LISTEN_PORT=9000
CF_DATABASE_URL=sqlite+aiosqlite:///./client.db
CF_MAX_SIGNAL_AGE_SEC=300
CF_RISK_CHECK_INTERVAL_SEC=10
CF_CONFIRM_TTL_SEC=600

# Telegram (optional: for pushes and confirm buttons)
CF_TELEGRAM_BOT_TOKEN=
CF_TELEGRAM_CHAT_ID=

# Binance USD-M futures (client's own trade-only keys)
CF_BINANCE_API_KEY=
CF_BINANCE_API_SECRET=
CF_BINANCE_TESTNET=true

# Hyperliquid (client's own agent wallet, no withdraw rights)
CF_HL_AGENT_PRIVATE_KEY=
CF_HL_AGENT_ADDRESS=
CF_HL_API_URL=https://api.hyperliquid.xyz
